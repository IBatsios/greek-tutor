# copy to .env and fill in

# --- Database -----------------------------------------------------------------
# Docker: docker-compose.yml builds DATABASE_URL from POSTGRES_PASSWORD and
# ignores the DATABASE_URL line below. Use a URL-safe password: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Python on the host only (Docker ignores this line). Two choices — RUNBOOK.md:
#   Postgres from compose (`docker compose up -d db`):  ...@127.0.0.1:5433/greektutor
#   Postgres installed on Windows:                      ...@localhost:5432/greektutor
DATABASE_URL=postgresql://tutor:CHANGE_ME@127.0.0.1:5433/greektutor
# Host port for the compose database (localhost only)
DB_PORT=5433

# --- How the app reaches Claude ------------------------------------------------
# api        = Anthropic API key, pay per token, any number of learners (default)
# claude_cli = the claude binary signed in with YOUR Claude Pro/Max subscription.
#              Single learner only (signup closes after the first account; the app
#              refuses to start with two). See README → "Choosing how the app talks to Claude".
LLM_BACKEND=api
# api backend:
ANTHROPIC_API_KEY=sk-ant-...
# claude_cli backend: run `claude setup-token` on your own machine, paste the token here.
# Docker also needs WITH_CLAUDE_CLI=true (then rebuild). Bare metal: a `claude /login`
# on the same machine works too, leave the token empty.
CLAUDE_CODE_OAUTH_TOKEN=
WITH_CLAUDE_CLI=false
CLAUDE_CLI_VERSION=stable
CLAUDE_CLI_TIMEOUT=120
# Model routing (see https://docs.claude.com/en/api/overview for current model list)
TUTOR_MODEL=claude-haiku-4-5-20251001
EVAL_MODEL=claude-sonnet-4-6

# --- Quotas -------------------------------------------------------------------
DAILY_AI_MINUTES=90
SESSION_MAX_TURNS=120

# --- Web ----------------------------------------------------------------------
COOKIE_SECRET=CHANGE_ME_LONG_RANDOM
# true behind HTTPS (Cloudflare Tunnel / Caddy) and on http://localhost.
# Set false only if you test over plain http on a LAN IP — otherwise login silently fails.
COOKIE_SECURE=true
# Host port for docker compose (container always listens on 8080)
APP_PORT=8080

# --- Calendar -----------------------------------------------------------------
# IANA zone for "today" in both the app and every DB connection (quota day, SRS due
# dates, Harada cycle). Set it to where you practise; default UTC.
APP_TIMEZONE=America/New_York

# --- Board mirror for the tracker (docs/HARADA_BOARD_CONTRACT.md) -------------
# Rewritten atomically after every board change; leave empty to disable.
# In Docker this is a path INSIDE the container — mount a host folder to reach it.
HARADA_EXPORT_PATH=
# Pin to one users.id; unset = export only while exactly one account exists (then it stops).
HARADA_EXPORT_USER_ID=
