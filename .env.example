# copy to .env and fill in

# --- Database -----------------------------------------------------------------
# Docker: docker-compose.yml builds DATABASE_URL from POSTGRES_PASSWORD and
# ignores the DATABASE_URL line below. Use a URL-safe password: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Bare-metal (no Docker) only:
DATABASE_URL=postgresql://tutor:CHANGE_ME@localhost:5432/greektutor

# --- Claude API ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Model routing (see https://docs.claude.com/en/api/overview for current model list)
TUTOR_MODEL=claude-haiku-4-5-20251001
EVAL_MODEL=claude-sonnet-4-6

# --- Quotas -------------------------------------------------------------------
DAILY_AI_MINUTES=90
SESSION_MAX_TURNS=120

# --- Web ----------------------------------------------------------------------
COOKIE_SECRET=CHANGE_ME_LONG_RANDOM
# true behind HTTPS (Cloudflare Tunnel / Caddy) and on http://localhost.
# Set false only if you test over plain http on a LAN IP — otherwise login silently fails.
COOKIE_SECURE=true
# Host port for docker compose (container always listens on 8080)
APP_PORT=8080
